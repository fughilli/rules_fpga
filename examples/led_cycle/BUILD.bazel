"""Example: walk a lit LED across the Tang Nano 9K's 6 onboard LEDs."""

load(
    "//fpga/rules:defs.bzl",
    "fpga_flash",
    "synthesizable_bitstream",
    "verilog_library",
    "verilog_test",
    "verilog_top",
)

package(default_visibility = ["//visibility:public"])

verilog_library(
    name = "led_cycle",
    srcs = ["led_cycle.v"],
)

verilog_top(
    name = "led_cycle_top",
    top = "led_cycle",
    deps = [":led_cycle"],
)

verilog_test(
    name = "led_cycle_test",
    size = "small",
    tb = "led_cycle_tb.v",
    top = "led_cycle_tb",
    deps = [":led_cycle"],
)

synthesizable_bitstream(
    name = "led_cycle_tangnano9k",
    constraints = "tangnano9k.cst",
    platform = "//fpga/platforms:tangnano9k",
    top = ":led_cycle_top",
)

fpga_flash(
    name = "led_cycle_tangnano9k_flash",
    bitstream = ":led_cycle_tangnano9k",
)
